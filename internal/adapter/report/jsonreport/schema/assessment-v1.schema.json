{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timothymamo/eu-sov-cloud/blob/main/internal/adapter/report/jsonreport/schema/assessment-v1.schema.json",
  "title": "eusov assessment report, version 1",
  "description": "The JSON report of one inventory assessed against one target.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "description": "The format version (docs/adr/0018).",
      "const": 1
    },
    "kind": {
      "description": "The document's kind.",
      "const": "assessment"
    },
    "inventoryName": {
      "type": "string",
      "description": "The inventory file's base name, or empty when it did not come from a file."
    },
    "source": {
      "type": "string",
      "description": "The source the inventory was taken from."
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "resources": {
      "type": "array",
      "description": "One verdict per resource, in the inventory's order.",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "blockers": {
      "type": "array",
      "description": "One entry per reason a resource cannot move, in resource order.",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "inventoryName",
    "source",
    "target",
    "summary",
    "resources",
    "blockers"
  ],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "description": "The target assessed against and its catalog snapshot.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The target's display name."
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "name",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "description": "Where the target's catalog was taken from and when.",
      "properties": {
        "source": {
          "type": "string",
          "description": "The snapshot's source URL, as stored."
        },
        "retrieved": {
          "type": "string",
          "description": "The UTC calendar date the snapshot was retrieved, YYYY-MM-DD.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "required": [
        "source",
        "retrieved"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "description": "The number of resources per fit, and in total.",
      "properties": {
        "direct": {
          "type": "integer",
          "description": "Resources with a direct fit.",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "description": "Resources with a partial fit.",
          "minimum": 0
        },
        "none": {
          "type": "integer",
          "description": "Resources with no fit.",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "description": "Resources assessed.",
          "minimum": 0
        }
      },
      "required": [
        "direct",
        "partial",
        "none",
        "total"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "description": "The verdict on one resource.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The resource's ID."
        },
        "rawType": {
          "type": "string",
          "description": "The source's own type name, or empty."
        },
        "category": {
          "type": "string",
          "description": "The taxonomy category."
        },
        "region": {
          "type": "string",
          "description": "The source region, or empty."
        },
        "fit": {
          "type": "string",
          "description": "How well the best offering fits.",
          "enum": [
            "direct",
            "partial",
            "none"
          ]
        },
        "bestOffering": {
          "type": "string",
          "description": "The best candidate offering's name, or empty when there is none."
        },
        "ties": {
          "type": "array",
          "description": "The other candidates with the best one's fit and as many missing capabilities, in candidate order.",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "description": "The reasons for the fit.",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "requiredChanges": {
          "type": "array",
          "description": "For a partial fit, the capabilities the best offering lacks; empty otherwise.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "rawType",
        "category",
        "region",
        "fit",
        "bestOffering",
        "ties",
        "reasons",
        "requiredChanges"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "description": "One reason: a code, its plain sentence, and the names it mentions, each present only when set.",
      "properties": {
        "code": {
          "type": "string",
          "description": "The reason code; a consumer must accept a code it does not know."
        },
        "text": {
          "type": "string",
          "description": "The reason as a plain sentence, not Markdown."
        },
        "target": {
          "type": "string",
          "description": "The target display name the reason mentions."
        },
        "category": {
          "type": "string",
          "description": "The taxonomy category the reason mentions."
        },
        "offering": {
          "type": "string",
          "description": "The offering name the reason mentions."
        },
        "capability": {
          "type": "string",
          "description": "The capability the reason mentions."
        }
      },
      "required": [
        "code",
        "text"
      ],
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "description": "One reason a resource cannot move.",
      "properties": {
        "resourceId": {
          "type": "string",
          "description": "The blocked resource's ID."
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "required": [
        "resourceId",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
