        "additionalProperties": false,
        "description": "The JSON report of one inventory compared across several targets.",
        "properties": {
          "inventoryName": {
            "description": "The inventory file's base name, or empty when it did not come from a file.",
            "type": "string"
          },
          "kind": {
            "const": "comparison",
            "description": "The document's kind."
          },
          "schemaVersion": {
            "const": 1,
            "description": "The format version (docs/adr/0018).",
