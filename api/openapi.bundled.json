              },
              "none": {
                "description": "Resources with no fit.",
                "minimum": 0,
                "type": "integer"
              },
              "partial": {
                "description": "Resources with a partial fit.",
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "description": "Resources assessed.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
