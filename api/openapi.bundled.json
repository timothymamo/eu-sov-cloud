            "properties": {
              "name": {
                "description": "The target's display name.",
                "type": "string"
              },
              "snapshot": {
                "$ref": "#/components/schemas/ComparisonReportV1/$defs/snapshot"
              }
            },
            "required": [
              "name",
              "snapshot"
            ],
            "type": "object"
          },
