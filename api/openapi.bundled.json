{
  "components": {
    "headers": {
      "Access-Control-Allow-Headers": {
        "description": "The request headers a client may send.",
        "schema": {
          "const": "Authorization, Content-Type, Accept",
          "type": "string"
        }
      },
      "Access-Control-Allow-Methods": {
        "description": "The methods of the path.",
        "schema": {
          "type": "string"
        }
      },
      "Access-Control-Allow-Origin": {
        "description": "The request's Origin, only when it matches the configured allow-list (scheme and host ignoring case, port exactly once the scheme's default port, 443 for https and 80 for http, is dropped on both sides); never *.",
        "schema": {
          "type": "string"
        }
      },
      "Access-Control-Expose-Headers": {
        "description": "The response headers a browser at an allowed origin may read: the back-off of 503 busy and the challenge of 401 unauthorized.",
        "schema": {
          "const": "Retry-After, WWW-Authenticate",
          "type": "string"
        }
      },
      "Access-Control-Max-Age": {
        "description": "Seconds a preflight may be cached.",
        "schema": {
          "const": "600",
          "type": "string"
        }
      },
      "Allow": {
        "description": "The methods the path allows.",
        "schema": {
          "type": "string"
        }
      },
      "Cache-Control": {
        "description": "Always no-store.",
        "schema": {
          "const": "no-store",
          "type": "string"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "const": "1",
          "type": "string"
        }
      },
      "Vary": {
        "description": "Origin, on every response while the server is configured with an allow-list of CORS origins, whatever the request's Origin.",
        "schema": {
          "type": "string"
        }
      },
      "WWW-Authenticate": {
        "description": "The bearer challenge.",
        "schema": {
          "const": "Bearer",
          "type": "string"
        }
      },
      "X-Content-Type-Options": {
        "description": "Always nosniff.",
        "schema": {
          "const": "nosniff",
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The body, the inventory or the target list is invalid. Codes: invalid_request, invalid_inventory, invalid_targets.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "Busy": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The concurrency cap is reached; retry later. Codes: busy.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "Internal": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "An internal error; the message is always internal error. Codes: internal.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "MethodNotAllowed": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The path does not allow this method. Codes: method_not_allowed.",
        "headers": {
          "Allow": {
            "$ref": "#/components/headers/Allow"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "MisdirectedRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The server is configured with an allow-list of hosts and the request's Host is not in it, compared ignoring case (an entry without a port matches any port). Checked before anything else; /healthz and /readyz are exempt. Codes: misdirected_request.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "NotAcceptable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "No representation the Accept header allows. Codes: not_acceptable.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "No route has this path. Codes: not_found.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "NotReady": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The readiness check failed. Codes: not_ready.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "PayloadTooLarge": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The body is over the cap. Codes: payload_too_large.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "A token is configured and the request does not carry it. Codes: unauthorized.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WWW-Authenticate"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      },
      "UnsupportedMediaType": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The body is not application/json, or has a charset other than utf-8. Codes: unsupported_media_type.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/Cache-Control"
          },
          "X-Content-Type-Options": {
            "$ref": "#/components/headers/X-Content-Type-Options"
          }
        }
      }
    },
    "schemas": {
      "AssessmentReportV1": {
        "$defs": {
          "blocker": {
            "additionalProperties": false,
            "description": "One reason a resource cannot move.",
            "properties": {
              "reason": {
                "$ref": "#/components/schemas/AssessmentReportV1/$defs/reason"
              },
              "resourceId": {
                "description": "The blocked resource's ID.",
                "type": "string"
              }
            },
            "required": [
              "resourceId",
              "reason"
            ],
            "type": "object"
          },
          "reason": {
            "additionalProperties": false,
            "description": "One reason: a code, its plain sentence, and the names it mentions, each present only when set.",
            "properties": {
              "capability": {
                "description": "The capability the reason mentions.",
                "type": "string"
              },
              "category": {
                "description": "The taxonomy category the reason mentions.",
                "type": "string"
              },
              "code": {
                "description": "The reason code; a consumer must accept a code it does not know.",
                "type": "string"
              },
              "offering": {
                "description": "The offering name the reason mentions.",
                "type": "string"
              },
              "target": {
                "description": "The target display name the reason mentions.",
                "type": "string"
              },
              "text": {
                "description": "The reason as a plain sentence, not Markdown.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "text"
            ],
            "type": "object"
          },
          "resource": {
            "additionalProperties": false,
            "description": "The verdict on one resource.",
            "properties": {
              "bestOffering": {
                "description": "The best candidate offering's name, or empty when there is none.",
                "type": "string"
              },
              "category": {
                "description": "The taxonomy category.",
                "type": "string"
              },
              "fit": {
                "description": "How well the best offering fits.",
                "enum": [
                  "direct",
                  "partial",
                  "none"
                ],
                "type": "string"
              },
              "id": {
                "description": "The resource's ID.",
                "type": "string"
              },
              "rawType": {
                "description": "The source's own type name, or empty.",
                "type": "string"
              },
              "reasons": {
                "description": "The reasons for the fit.",
                "items": {
                  "$ref": "#/components/schemas/AssessmentReportV1/$defs/reason"
                },
                "type": "array"
              },
              "region": {
                "description": "The source region, or empty.",
                "type": "string"
              },
              "requiredChanges": {
                "description": "For a partial fit, the capabilities the best offering lacks; empty otherwise.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "ties": {
                "description": "The other candidates with the best one's fit and as many missing capabilities, in candidate order.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "rawType",
              "category",
              "region",
              "fit",
              "bestOffering",
              "ties",
              "reasons",
              "requiredChanges"
            ],
            "type": "object"
          },
          "snapshot": {
            "additionalProperties": false,
            "description": "Where the target's catalog was taken from and when.",
            "properties": {
              "retrieved": {
                "description": "The UTC calendar date the snapshot was retrieved, YYYY-MM-DD.",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "source": {
                "description": "The snapshot's source URL, as stored.",
                "type": "string"
              }
            },
            "required": [
              "source",
              "retrieved"
            ],
            "type": "object"
          },
          "summary": {
            "additionalProperties": false,
            "description": "The number of resources per fit, and in total.",
            "properties": {
              "direct": {
                "description": "Resources with a direct fit.",
                "minimum": 0,
                "type": "integer"
              },
              "none": {
                "description": "Resources with no fit.",
                "minimum": 0,
                "type": "integer"
              },
              "partial": {
                "description": "Resources with a partial fit.",
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "description": "Resources assessed.",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "direct",
              "partial",
              "none",
              "total"
            ],
            "type": "object"
          },
          "target": {
            "additionalProperties": false,
            "description": "The target assessed against and its catalog snapshot.",
            "properties": {
              "name": {
                "description": "The target's display name.",
                "type": "string"
              },
              "snapshot": {
                "$ref": "#/components/schemas/AssessmentReportV1/$defs/snapshot"
              }
            },
            "required": [
              "name",
              "snapshot"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "The JSON report of one inventory assessed against one target.",
        "properties": {
          "blockers": {
            "description": "One entry per reason a resource cannot move, in resource order.",
            "items": {
              "$ref": "#/components/schemas/AssessmentReportV1/$defs/blocker"
            },
            "type": "array"
          },
          "inventoryName": {
            "description": "The inventory file's base name, or empty when it did not come from a file.",
            "type": "string"
          },
          "kind": {
            "const": "assessment",
            "description": "The document's kind."
          },
          "resources": {
            "description": "One verdict per resource, in the inventory's order.",
            "items": {
              "$ref": "#/components/schemas/AssessmentReportV1/$defs/resource"
            },
            "type": "array"
          },
          "schemaVersion": {
            "const": 1,
            "description": "The format version (docs/adr/0018).",
            "type": "integer"
          },
          "source": {
            "description": "The source the inventory was taken from.",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/AssessmentReportV1/$defs/summary"
          },
          "target": {
            "$ref": "#/components/schemas/AssessmentReportV1/$defs/target"
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "inventoryName",
          "source",
          "target",
          "summary",
          "resources",
          "blockers"
        ],
        "title": "shift2eu assessment report, version 1",
        "type": "object"
      },
      "AssessmentRequest": {
        "additionalProperties": false,
        "description": "The body of POST /v1/assessments.",
        "properties": {
          "inventory": {
            "description": "An inventory document, version 1 or 2 (docs/adr/0006, docs/adr/0024), read with the CLI's inventory reader and its rules; one it refuses is 400 invalid_inventory, whose message names the position and field at fault (resources[1].category), never the value.",
            "type": "object"
          },
          "targets": {
            "description": "One or more target keys (see GET /v1/targets), or [\"all\"] alone. An unknown, repeated or empty key, or all with another key, is 400 invalid_targets.",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "inventory",
          "targets"
        ],
        "type": "object"
      },
      "ComparisonReportV1": {
        "$defs": {
          "blocker": {
            "additionalProperties": false,
            "description": "One reason a resource cannot move.",
            "properties": {
              "reason": {
                "$ref": "#/components/schemas/ComparisonReportV1/$defs/reason"
              },
              "resourceId": {
                "description": "The blocked resource's ID.",
                "type": "string"
              }
            },
            "required": [
              "resourceId",
              "reason"
            ],
            "type": "object"
          },
          "reason": {
            "additionalProperties": false,
            "description": "One reason: a code, its plain sentence, and the names it mentions, each present only when set.",
            "properties": {
              "capability": {
                "description": "The capability the reason mentions.",
                "type": "string"
              },
              "category": {
                "description": "The taxonomy category the reason mentions.",
                "type": "string"
              },
              "code": {
                "description": "The reason code; a consumer must accept a code it does not know.",
                "type": "string"
              },
              "offering": {
                "description": "The offering name the reason mentions.",
                "type": "string"
              },
              "target": {
                "description": "The target display name the reason mentions.",
                "type": "string"
              },
              "text": {
                "description": "The reason as a plain sentence, not Markdown.",
                "type": "string"
              }
            },
            "required": [
              "code",
              "text"
            ],
            "type": "object"
          },
          "resource": {
            "additionalProperties": false,
            "description": "The verdict on one resource.",
            "properties": {
              "bestOffering": {
                "description": "The best candidate offering's name, or empty when there is none.",
                "type": "string"
              },
              "category": {
                "description": "The taxonomy category.",
                "type": "string"
              },
              "fit": {
                "description": "How well the best offering fits.",
                "enum": [
                  "direct",
                  "partial",
                  "none"
                ],
                "type": "string"
              },
              "id": {
                "description": "The resource's ID.",
                "type": "string"
              },
              "rawType": {
                "description": "The source's own type name, or empty.",
                "type": "string"
              },
              "reasons": {
                "description": "The reasons for the fit.",
                "items": {
                  "$ref": "#/components/schemas/ComparisonReportV1/$defs/reason"
                },
                "type": "array"
              },
              "region": {
                "description": "The source region, or empty.",
                "type": "string"
              },
              "requiredChanges": {
                "description": "For a partial fit, the capabilities the best offering lacks; empty otherwise.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "ties": {
                "description": "The other candidates with the best one's fit and as many missing capabilities, in candidate order.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "id",
              "rawType",
              "category",
              "region",
              "fit",
              "bestOffering",
              "ties",
              "reasons",
              "requiredChanges"
            ],
            "type": "object"
          },
          "sharedBlocker": {
            "additionalProperties": false,
            "description": "A resource blocked on every compared target.",
            "properties": {
              "resourceId": {
                "description": "The blocked resource's ID.",
                "type": "string"
              },
              "targets": {
                "description": "Each target's reasons, in target order.",
                "items": {
                  "$ref": "#/components/schemas/ComparisonReportV1/$defs/targetReasons"
                },
                "type": "array"
              }
            },
            "required": [
              "resourceId",
              "targets"
            ],
            "type": "object"
          },
          "snapshot": {
            "additionalProperties": false,
            "description": "Where the target's catalog was taken from and when.",
            "properties": {
              "retrieved": {
                "description": "The UTC calendar date the snapshot was retrieved, YYYY-MM-DD.",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "source": {
                "description": "The snapshot's source URL, as stored.",
                "type": "string"
              }
            },
            "required": [
              "source",
