{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep workflow actions pinned to commit SHAs, with the version in a trailing comment.
    'helpers:pinGitHubActionDigests',
    ':semanticCommits',
  ],
  // Run every night. Renovate schedules by the hour, not the minute, so PRs open on its first run
  // between 00:00 and 00:59 Amsterdam time.
  timezone: 'Europe/Amsterdam',
  schedule: ['* 0 * * *'],
  labels: ['dependencies'],
  postUpdateOptions: ['gomodTidy'],
  // Open security PRs from the OSV database straight away, outside the nightly schedule.
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      description: 'Batch non-major Go module updates into one PR',
      matchManagers: ['gomod'],
      matchDepTypes: ['require', 'indirect'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Go modules',
    },
    {
      description: 'Batch GitHub Actions updates into one PR',
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
    {
      // shift2eu is an application, so it is built with the Go it declares. Renovate leaves the go
      // directive alone by default; bump it together with the VM's Go version.
      description: 'Go toolchain: go.mod go directive and dev/lima.yaml',
      matchDatasources: ['golang-version'],
      rangeStrategy: 'bump',
      groupName: 'Go toolchain',
    },
    {
      // The Dockerfile builder's tag is the go.mod version (test/container fails when they differ),
      // so its tag and digest move in the same PR as the go directive.
      description: 'Go toolchain: the Dockerfile golang builder image',
      matchDatasources: ['docker'],
      matchDepNames: ['golang'],
      groupName: 'Go toolchain',
    },
    {
      description: 'golangci-lint: CI and dev/lima.yaml stay on the same version',
      matchDepNames: ['golangci/golangci-lint'],
      groupName: 'golangci-lint',
    },
    {
      description: 'govulncheck: CI and dev/lima.yaml stay on the same version',
      matchDepNames: ['golang.org/x/vuln'],
      groupName: 'govulncheck',
    },
    {
      // dev/lima.yaml pins gh and cosign by version and by a SHA-256 per architecture, each a dependency
      // of its own: bump them in one PR, so the version never moves without its digests.
      description: 'gh: dev/lima.yaml version and per-architecture digests together',
      matchDepNames: ['cli/cli'],
      groupName: 'gh',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies each pinned digest against gh\'s build attestation (ADR 0017). Every `digestVersion` in `dev/lima.yaml` must equal the new `ghVersion`. The same digests change in each `dev/testdata/lima-invalid/*.yaml`: those copies follow `dev/lima.yaml` and are held equal to it by `test/devenv`. They are never provisioned, so only `dev/lima.yaml`\'s copy is verified; review that one.',
      ],
    },
    {
      description: 'cosign: release.yml, and dev/lima.yaml version and per-architecture digests, together',
      matchDepNames: ['sigstore/cosign'],
      groupName: 'cosign',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies each pinned digest against sigstore/cosign\'s signature with an independently installed cosign (ADR 0017). Every `digestVersion` in `dev/lima.yaml` must equal the new `cosignVersion`. The same digests change in each `dev/testdata/lima-invalid/*.yaml`: those copies follow `dev/lima.yaml` and are held equal to it by `test/devenv`. They are never provisioned, so only `dev/lima.yaml`\'s copy is verified; review that one.',
      ],
    },
    {
      // dev/lima.yaml pins shellcheck by version and a SHA-256 per architecture, and ci.yml's lint-shell job
      // by the same version and the amd64 SHA-256 (test/architecture holds them equal): one PR for all.
      description: 'shellcheck: dev/lima.yaml and ci.yml version and digests together',
      matchDepNames: ['koalaman/shellcheck'],
      groupName: 'shellcheck',
      prBodyNotes: [
        '**Before merging:** every `digestVersion` in `dev/lima.yaml` and `.github/workflows/ci.yml` must equal the new version, and the "Lint" check must be green: its lint-shell job downloads the release and checks it against `SHELLCHECK_SHA256`. shellcheck releases carry no signature or attestation, so compare the new digests with those GitHub lists for the release assets. The same digests change in each `dev/testdata/lima-invalid/*.yaml`, held equal to `dev/lima.yaml` by `test/devenv`. New findings the version reports are fixed in this PR.',
      ],
    },
    {
      // The vm-tools workflow pins Lima by version and by the SHA-256 of its Linux tarball.
      description: 'Lima: vm-tools.yml version and digest together',
      matchDepNames: ['lima-vm/lima'],
      groupName: 'Lima',
      prBodyNotes: [
        '**Before merging:** the "VM tools" check must be green: it verifies the Lima tarball against lima-vm/lima\'s build attestation before it checks `LIMA_SHA256`. `digestVersion` in `.github/workflows/vm-tools.yml` must equal the new `LIMA_VERSION`. Upgrade your own Lima to the same version (`brew upgrade lima`).',
      ],
    },
    {
      // A digest update keeps the tag: the release asset behind an existing gh or cosign tag was replaced.
      // That is how a compromised release looks, so it gets a PR of its own that is never automerged.
      // Defence in depth only: the github-release-attachments datasource (Renovate 44) keeps the pinned
      // digest when the tag is unchanged, so it proposes no such PR today. What catches a replaced asset
      // is the weekly run of .github/workflows/vm-tools.yml, which then fails on the pin.
      description: 'gh, cosign, Lima and shellcheck: a release asset changed under an existing tag',
      matchDepNames: ['cli/cli', 'sigstore/cosign', 'lima-vm/lima', 'koalaman/shellcheck'],
      matchUpdateTypes: ['digest'],
      groupName: 'replaced gh, cosign, Lima or shellcheck release asset',
      addLabels: ['security-review'],
      automerge: false,
      prBodyNotes: [
        '**Security review required. Do not merge without investigation.** The asset of an existing release tag changed: the new digest is not a new version. Find out from the upstream project why the asset was replaced, and merge only once that is explained and the "VM tools" check is green.',
      ],
    },
  ],
  customManagers: [
    {
      // "# renovate: datasource=github-release-attachments depName=<owner/repo> digestVersion=<tag>" above
      // a quoted SHA-256 of one release asset. Renovate finds the asset whose digest it is in the
      // <tag> release (through the release's checksum file), takes the same asset's digest from the
      // new release, and updates digestVersion and the digest together.
      description: 'SHA-256 digests of GitHub release assets in dev/lima.yaml, the vm-tools workflow and ci.yml',
      customType: 'regex',
      managerFilePatterns: [
        '/^dev/lima\\.yaml$/',
        // The broken Lima templates in dev/testdata/lima-invalid are dev/lima.yaml with one breakage each,
        // which test/devenv pins: Renovate bumps their pins in the same PR as dev/lima.yaml's, so a bump does
        // not leave them behind and fail that test.
        '/^dev/testdata/lima-invalid/[^/]+\\.yaml$/',
        '/^\\.github/workflows/vm-tools\\.yml$/',
        // ci.yml's lint-shell job pins the shellcheck release the VM does.
        '/^\\.github/workflows/ci\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\s+\\S+:\\s*"(?<currentDigest>[a-f0-9]{64})"',
      ],
    },
    {
      // An optional "@sha256:..." after the value is the digest (docker datasource): Renovate then
      // updates the tag and the digest together. A value of the form "image=<name>:<tag>", as in
      // setup-buildx-action's driver-opts, is read from its tag.
      description: 'Versions annotated with "# renovate: datasource=... depName=..." on the line above',
      customType: 'regex',
      managerFilePatterns: [
        '/^dev/lima\\.yaml$/',
        '/^dev/testdata/lima-invalid/[^/]+\\.yaml$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+:\\s*(?:image=[^\\s:]+:)?"?(?<currentValue>[^"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"?',
      ],
    },
  ],
}
