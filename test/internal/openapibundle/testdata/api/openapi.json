{
  "openapi": "3.1.0",
  "info": {
    "title": "Widgets",
    "version": "1"
  },
  "paths": {
    "/gadgets": {
      "get": {
        "responses": {
          "200": {
            "description": "A gadget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/gadget-v1.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/widgets": {
      "get": {
        "responses": {
          "200": {
            "description": "A widget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/widget-v1.schema.json"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/widgets/count": {
      "get": {
        "responses": {
          "200": {
            "description": "How many widgets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/widget-v1.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "An error."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
